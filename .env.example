# Required — Phase 1
ANTHROPIC_API_KEY=your-anthropic-api-key-here
DD_API_KEY=your-datadog-api-key-here          # Datadog API key (scoped to a service account)
DD_APP_KEY=your-datadog-application-key-here  # Datadog Application key
DD_SITE=datadoghq.com                         # US1; use datadoghq.eu for EU, us3.datadoghq.com for US3, etc.

# Datadog MCP server URL (Streamable HTTP transport with API key header auth).
# Find your site-specific URL at: https://docs.datadoghq.com/bits_ai/mcp_server/setup/
# Defaults to https://mcp.<DD_SITE> if unset.
# Leave empty to use the local datadog_mcp_cli binary (requires: datadog_mcp_cli login).
DD_MCP_URL=https://mcp.datadoghq.com

# Optional — Phase 2 (Workato)
# Agent degrades gracefully without these
WORKATO_WEBHOOK_SF_READ=
WORKATO_WEBHOOK_TFS_WRITE=
WORKATO_API_KEY=
WORKATO_WEBHOOK_TEAMS_NOTIFY=
WORKATO_WEBHOOK_SF_UPDATE=

# Optional
CHAT_BASE_URL=http://localhost:8000
SMOKE_THRESHOLD=100
